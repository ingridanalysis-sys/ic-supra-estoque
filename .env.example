# Copie para ".env" (não commitado) pra testar a persistência Supabase em
# "npm run dev". Sem essas duas variáveis o app funciona normalmente em modo
# local (localStorage), sem nenhum erro — elas são opcionais.
#
# Pegue os valores em: Supabase → Project Settings → API.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só necessária pra testar a função de IA localmente com "netlify dev"
# (não funciona com "npm run dev" puro). Em produção isso é uma env var do
# Netlify, não deste arquivo.
ANTHROPIC_API_KEY_ICSUPRA=
